# Env file resolution order (first existing wins):
#   1. $ENV_FILE, if set, is used verbatim with no fallback.
#   2. an .env next to the executable, so it starts from any working directory.
#   3. an .env in the current working directory.
# Real environment variables always take precedence over the file.

# Port to listen on
PORT=8080

# Bearer/query token. Leave empty to disable auth.
TOKEN=

# Set to 1/true when running behind a trusted reverse proxy (e.g. nginx) so
# X-Forwarded-For / X-Real-IP are used as the client IP. Keep off when the
# service is exposed directly, since these headers can be forged.
TRUST_PROXY=0
